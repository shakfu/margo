# At least one provider key is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# OPENAI_API_KEY doubles as the embedder key for knowledge indexing
# (pkg/margo/rag). Without it the Knowledge tab silently indexes
# nothing, because WorkspaceRegistry.IndexerFor cannot build an
# embedder and returns nil.
